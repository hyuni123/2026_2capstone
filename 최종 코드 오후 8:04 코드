#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>

// ==================== 핀 설정 (제공된 핀 맵) ====================
const int MOTOR1_DIR = 15; // 모터1 DIR+ (노란색)[cite: 3]
const int MOTOR1_PUL = 2;  // 모터1 PUL+ (주황색)[cite: 3]

const int TRIG_PIN = 14;   // 초음파센서1 TRIG[cite: 3]
const int ECHO_PIN = 13;   // 초음파센서1 ECHO[cite: 3]

const int LIMIT_SW_1 = 12; // 리미트 스위치1 SIGNAL[cite: 4]

// MPU6050 객체 (SDA: GPIO 22, SCL: GPIO 23)[cite: 4]
Adafruit_MPU6050 mpu;

// ==================== 하드웨어 및 변수 설정 ====================
const float LEAD_MM = 2.0;       // 리드 스크류 Lead 2mm
const int STEPS_PER_REV = 200;   // NEMA 17 기본 스텝 (1.8도)
const int MICROSTEP = 8;         // TB6600 마이크로스텝 설정 (1/8)
const float PULSES_PER_MM = (STEPS_PER_REV * MICROSTEP) / LEAD_MM; // 1mm당 800 펄스

const int STEP_DELAY_US = 800;    // 모터 속도 (마이크로초)
const float DIST_THRESHOLD = 3.0; // 동작 시작 감지 문턱값 (3.0 cm)

float baseDistance = 0.0;        // 부팅 시 측정된 공중에서의 '처음 거리'
int currentExtendedSteps = 0;    // 연장된 누적 스텝(펄스) 수
bool isGrounded = false;         // 지면 착지 여부

// ==================== 함수 선언 ====================
float getDistance();
void displayMPU();
void extendStep();
void retractStep();
void retractToOrigin();

void setup() {
  Serial.begin(115200);

  // 핀 모드 설정
  pinMode(MOTOR1_DIR, OUTPUT);
  pinMode(MOTOR1_PUL, OUTPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  
  // 리미트 스위치 내부 풀업 (스위치 눌림 = LOW, 떼어짐 = HIGH)
  pinMode(LIMIT_SW_1, INPUT_PULLUP);

  // MPU6050 I2C 초기화 (SDA: 22, SCL: 23)[cite: 4]
  Wire.begin(22, 23);
  if (!mpu.begin()) {
    Serial.println("[경고] MPU6050 센서 연결 실패!");
  } else {
    Serial.println("[성공] MPU6050 센서 연결 완료.");
  }

  delay(1000);

  // 시작 시점: 완전 수축 상태 (스텝 0)
  currentExtendedSteps = 0;

  // 바닥에서 띄워진 상태에서의 '처음 거리' 측정 (5회 평균)
  float sum = 0;
  for (int i = 0; i < 5; i++) {
    sum += getDistance();
    delay(50);
  }
  baseDistance = sum / 5.0;

  Serial.println("==========================================");
  Serial.print("부팅 시 처음 거리(Base Distance): ");
  Serial.print(baseDistance);
  Serial.println(" cm");
  Serial.println("지면 감지 모드 시작 (거리 증가 시 연장 실행)");
  Serial.println("==========================================");
}

void loop() {
  // 1. MPU6050 수평/기울기 모니터링 출력
  displayMPU();

  // 2. 현재 초음파 센서 거리 측정
  float currentDistance = getDistance();

  // 3. 리미트 스위치 1번 상태 읽기 (LOW = 눌림, HIGH = 떼어짐)
  bool limitPressed = (digitalRead(LIMIT_SW_1) == LOW);

  // ---------------- 메인 제어 논리 ----------------

  // [조건 1] 착지 상태(isGrounded)에서 사다리를 들거나 떼어내어 스위치가 떼어진 경우(HIGH)
  // -> 정확히 연장되었던 스텝 수만큼 반대로 회전하여 0스텝으로 자동 수축
  if (isGrounded && !limitPressed) {
    Serial.println("\n[이벤트] 사다리가 지면에서 떨어졌습니다 (스위치 OFF).");
    Serial.println("원래 상태(0스텝)로 자동 수축을 진행합니다.");
    
    retractToOrigin(); // 저장된 스텝 수만큼 역회전
    isGrounded = false;
  }
  
  // [조건 2] 측정한 거리가 '처음 거리 + 3cm' 이상으로 늘어났고, 아직 지면에 닿지 않은 경우
  // -> 다리를 연장하며 내려가다가 스위치가 눌리면(LOW) 즉시 정지
  else if ((currentDistance >= baseDistance + DIST_THRESHOLD) && !limitPressed) {
    Serial.print("[연장 동작] 현재 거리: ");
    Serial.print(currentDistance);
    Serial.print(" cm (기준: ");
    Serial.print(baseDistance + DIST_THRESHOLD);
    Serial.println(" cm 이상)");

    // 지면에 닿을 때까지 미세 스텝 단위로 연장
    for (int i = 0; i < 50; i++) {
      if (digitalRead(LIMIT_SW_1) == LOW) { // 바닥 접촉 즉시 반응
        Serial.println("\n[지면 감지] 리미트 스위치가 눌렸습니다 (LOW)!");
        Serial.println("연장을 즉시 중단하고 지면 감지 상태(isGrounded = true)로 전환합니다.");
        isGrounded = true;
        break;
      }
      extendStep();
    }
  }

  delay(50); // 센서 주기 조정
}

// ==================== 하부 제어 함수 ====================

// 초음파 센서 거리 측정 (cm)
float getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000); // 30ms 타임아웃
  if (duration == 0) return baseDistance; // 센서 오류 시 기본값 유지

  return (duration * 0.0343) / 2.0;
}

// MPU6050 수평 상태 시리얼 출력
void displayMPU() {
  static unsigned long lastPrint = 0;
  if (millis() - lastPrint > 500) { // 0.5초 주기
    sensors_event_t a, g, temp;
    mpu.getEvent(&a, &g, &temp);

    // Roll(X축), Pitch(Y축) 각도 계산
    float roll = atan2(a.acceleration.y, a.acceleration.z) * 180.0 / PI;
    float pitch = atan2(-a.acceleration.x, sqrt(a.acceleration.y * a.acceleration.y + a.acceleration.z * a.acceleration.z)) * 180.0 / PI;

    Serial.print("[MPU6050] Roll: ");
    Serial.print(roll, 1);
    Serial.print("° | Pitch: ");
    Serial.print(pitch, 1);
    Serial.println("°");

    lastPrint = millis();
  }
}

// 1스텝 연장
void extendStep() {
  digitalWrite(MOTOR1_DIR, HIGH); // 연장 방향
  delayMicroseconds(5);
  digitalWrite(MOTOR1_PUL, HIGH);
  delayMicroseconds(STEP_DELAY_US);
  digitalWrite(MOTOR1_PUL, LOW);
  delayMicroseconds(STEP_DELAY_US);

  currentExtendedSteps++; // 연장된 스텝 수 카운트 증가
}

// 1스텝 수축
void retractStep() {
  digitalWrite(MOTOR1_DIR, LOW); // 수축 방향
  delayMicroseconds(5);
  digitalWrite(MOTOR1_PUL, HIGH);
  delayMicroseconds(STEP_DELAY_US);
  digitalWrite(MOTOR1_PUL, LOW);
  delayMicroseconds(STEP_DELAY_US);

  currentExtendedSteps--; // 연장된 스텝 수 카운트 차감
}

// exact하게 연장되었던 스텝 수만큼 역회전하여 원위치(0스텝) 복귀
void retractToOrigin() {
  digitalWrite(MOTOR1_DIR, LOW); // 수축 방향 설정
  delayMicroseconds(5);

  while (currentExtendedSteps > 0) {
    digitalWrite(MOTOR1_PUL, HIGH);
    delayMicroseconds(STEP_DELAY_US);
    digitalWrite(MOTOR1_PUL, LOW);
    delayMicroseconds(STEP_DELAY_US);

    currentExtendedSteps--; // 0이 될 때까지 차감
  }
  Serial.println("[복귀 완료] 정확히 원래 위치(0스텝)로 수축되었습니다.");
}
