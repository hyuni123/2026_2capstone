// =====================================================
// STEP 1개
// =====================================================

void oneStep(Leg &leg)
{
  digitalWrite(
    leg.stepPin,
    HIGH
  );


  delayMicroseconds(
    STEP_HIGH_US
  );


  digitalWrite(
    leg.stepPin,
    LOW
  );
}


// =====================================================
// 초음파센서 1번 측정
// =====================================================

float readDistanceOnceMm(Leg &leg)
{
  digitalWrite(
    leg.trigPin,
    LOW
  );

  delayMicroseconds(3);


  digitalWrite(
    leg.trigPin,
    HIGH
  );

  delayMicroseconds(10);


  digitalWrite(
    leg.trigPin,
    LOW
  );


  unsigned long duration =
    pulseIn(
      leg.echoPin,
      HIGH,
      ECHO_TIMEOUT_US
    );


  if (duration == 0)
  {
    return -1.0f;
  }


  float distanceMm =
    duration *
    0.343f /
    2.0f;


  if (
    distanceMm < 10.0f ||
    distanceMm > 1000.0f
  )
  {
    return -1.0f;
  }


  return distanceMm;
}


// =====================================================
// 현재 거리
//
// 3회 측정 후 중앙값 사용
// =====================================================

float readMedian3Mm(Leg &leg)
{
  float values[3];

  int count = 0;


  for (int i = 0; i < 3; i++)
  {
    float d =
      readDistanceOnceMm(
        leg
      );


    if (d > 0)
    {
      values[count] =
        d;

      count++;
    }


    delay(25);
  }


  if (count < 2)
  {
    return -1.0f;
  }


  // 정렬
  for (int i = 0; i < count - 1; i++)
  {
    for (int j = i + 1; j < count; j++)
    {
      if (
        values[j] <
        values[i]
      )
      {
        float temp =
          values[i];

        values[i] =
          values[j];

        values[j] =
          temp;
      }
    }
  }


  return
    values[count / 2];
}


// =====================================================
// ★ 초기 기준거리
//
// 정상값 정확히 10개 측정 후 평균
// =====================================================

float measureInitialAverage10(Leg &leg)
{
  float sum = 0.0f;

  int count = 0;


  Serial.println();

  Serial.print("LEG ");
  Serial.print(leg.number);

  Serial.println(
    " INITIAL CALIBRATION"
  );


  while (count < 10)
  {
    float d =
      readDistanceOnceMm(
        leg
      );


    if (d > 0)
    {
      sum += d;

      count++;


      Serial.print("  ");

      Serial.print(count);

      Serial.print("/10 = ");

      Serial.print(d, 1);

      Serial.println("mm");
    }


    delay(60);
  }


  float average =
    sum /
    10.0f;


  Serial.print("LEG ");
  Serial.print(leg.number);

  Serial.print(" BASELINE = ");

  Serial.print(
    average,
    1
  );

  Serial.println("mm");


  return average;
}


// =====================================================
// 연장 시작
// =====================================================

void startExtension(
  Leg &leg,
  float targetMm
)
{
  if (
    targetMm >
    MAX_EXTENSION_MM
  )
  {
    targetMm =
      MAX_EXTENSION_MM;
  }


  leg.targetMm =
    targetMm;


  leg.targetPulses =
    (long)(
      targetMm *
      PULSES_PER_MM
    );


  // 처음 위치에서 출발
  leg.currentPulses =
    0;


  // 연장 방향
  digitalWrite(
    leg.dirPin,
    leg.extendDir
  );


  leg.state =
    EXTENDING;


  leg.nextStepUs =
    micros();


  Serial.println();

  Serial.print(
    ">>> LEG "
  );

  Serial.print(
    leg.number
  );

  Serial.print(
    " START | TARGET="
  );

  Serial.print(
    targetMm,
    1
  );

  Serial.println(
    "mm"
  );
}


// =====================================================
// 연장 완료
// =====================================================

void finishExtension(
  Leg &leg
)
{
  digitalWrite(
    leg.stepPin,
    LOW
  );


  leg.state =
    HOLDING;


  leg.holdStartMs =
    millis();


  Serial.println();

  Serial.print(
    ">>> LEG "
  );

  Serial.print(
    leg.number
  );

  Serial.print(
    " EXTENSION COMPLETE = "
  );

  Serial.print(
    (float)leg.currentPulses /
    PULSES_PER_MM,
    1
  );

  Serial.println(
    "mm"
  );


  Serial.println(
    ">>> HOLD 5 SEC"
  );
}


// =====================================================
// 수축 시작
// =====================================================

void startRetraction(
  Leg &leg
)
{
  int retractDir =
    (leg.extendDir == HIGH)
    ? LOW
    : HIGH;


  digitalWrite(
    leg.dirPin,
    retractDir
  );


  leg.state =
    RETRACTING;


  leg.nextStepUs =
    micros();


  Serial.println();

  Serial.print(
    "<<< LEG "
  );

  Serial.print(
    leg.number
  );

  Serial.println(
    " RETRACT START"
  );
}


// =====================================================
// 수축 완료
// =====================================================

void finishRetraction(
  Leg &leg
)
{
  digitalWrite(
    leg.stepPin,
    LOW
  );


  leg.currentPulses =
    0;


  leg.targetPulses =
    0;


  leg.targetMm =
    0.0f;


  leg.clearConfirmCount =
    0;


  // 바로 다시 연장하지 않도록
  // 센서가 기준거리로 돌아올 때까지 기다림
  leg.state =
    WAIT_CLEAR;


  Serial.println();

  Serial.print(
    "<<< LEG "
  );

  Serial.print(
    leg.number
  );

  Serial.println(
    " RETRACT COMPLETE -> 0mm"
  );
}


// =====================================================
// 모터 상태 처리
//
// 핵심:
//
// while문 없음.
//
// LOOP가:
//
// LEG1
// LEG3
// LEG4
//
// 계속 빠르게 번갈아 STEP을 보냄.
//
// 따라서 여러 모터 동시 회전.
// =====================================================

void serviceLeg(Leg &leg)
{
  // =================================================
  // 연장
  // =====================================================

  if (
    leg.state ==
    EXTENDING
  )
  {
    if (
      leg.currentPulses >=
      leg.targetPulses
    )
    {
      finishExtension(
        leg
      );

      return;
    }


    unsigned long now =
      micros();


    if (
      (long)(
        now -
        leg.nextStepUs
      ) >= 0
    )
    {
      oneStep(
        leg
      );


      leg.currentPulses++;


      leg.nextStepUs =
        now +
        STEP_INTERVAL_US;
    }


    return;
  }


  // =================================================
  // 5초 정지
  // =====================================================

  if (
    leg.state ==
    HOLDING
  )
  {
    if (
      millis() -
      leg.holdStartMs
      >=
      HOLD_TIME_MS
    )
    {
      startRetraction(
        leg
      );
    }


    return;
  }


  // =================================================
  // 수축
  // =====================================================

  if (
    leg.state ==
    RETRACTING
  )
  {
    if (
      leg.currentPulses <=
      0
    )
    {
      finishRetraction(
        leg
      );

      return;
    }


    unsigned long now =
      micros();


    if (
      (long)(
        now -
        leg.nextStepUs
      ) >= 0
    )
    {
      oneStep(
        leg
      );


      leg.currentPulses--;


      leg.nextStepUs =
        now +
        STEP_INTERVAL_US;
    }


    return;
  }
}


// =====================================================
// 현재 동작 중인가?
// =====================================================

bool anyBusy()
{
  for (int i = 0; i < LEG_COUNT; i++)
  {
    if (
      legs[i].state == EXTENDING ||
      legs[i].state == HOLDING ||
      legs[i].state == RETRACTING
    )
    {
      return true;
    }
  }


  return false;
}


