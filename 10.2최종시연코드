#include <Arduino.h>

// =====================================================
// SMART LADDER - FINAL MULTI LEG VERSION
//
// 사용 다리 : 1 / 3 / 4
// LIMIT SWITCH 사용 안 함
//
// [초기]
// 1. 전원 ON
// 2. 3초 동안 모터 절대 움직이지 않음
// 3. 각 초음파센서 10번 측정
// 4. 10번 평균값 = 각 센서의 BASELINE
//
// [작동 조건]
// 현재거리 - BASELINE >= 10mm
//
// 단, 한 번 측정으로 바로 움직이지 않음.
//
// 1/3/4 전체 센서를 3라운드 측정하고
// 그중 2라운드 이상 멀어짐이 확인된 다리만 작동.
//
// 예)
// LEG1 : 변화 없음
// LEG3 : +30mm
// LEG4 : +25mm
//
// -> LEG1 그대로
// -> LEG3, LEG4 동시에 START
//
// [목표 연장]
// LEG1 = 센서 증가량 + 20mm
// LEG3 = 센서 증가량 + 37mm
// LEG4 = 센서 증가량 + 21mm
//
// [연장 이후]
// 목표거리까지 연장
// -> 5초 정지
// -> 실제 연장 STEP만큼 반대로 회전
// -> 처음 위치 0mm로 수축
// =====================================================


// =====================================================
// 모터 / 리드스크류 설정
// =====================================================

// T8 Lead = 2mm
// 200step/rev
// 1/8 microstep
//
// 200 * 8 / 2 = 800 pulse/mm

const float PULSES_PER_MM = 800.0f;


// =====================================================
// 각 다리의 현재 바닥과의 공극
// =====================================================

const float LEG1_GAP_MM = 20.0f;   // 2.0cm
const float LEG3_GAP_MM = 37.0f;   // 3.7cm
const float LEG4_GAP_MM = 21.0f;   // 2.1cm


// =====================================================
// 초음파 감지 조건
// =====================================================

// 기준보다 10mm 이상 멀어져야 실제 변화 후보
const float SENSOR_TRIGGER_MM = 10.0f;


// 수축 후 다시 기준거리로 돌아왔다고 보는 범위
const float CLEAR_MARGIN_MM = 6.0f;


// 전체 센서를 3라운드 확인
const int DETECTION_ROUNDS = 3;


// 3라운드 중 2번 이상 멀어졌으면 인정
const int MIN_DETECTION_HITS = 2;


// 수축 후 기준거리 복귀도 3번 확인
const int CLEAR_CONFIRM_ROUNDS = 3;


// =====================================================
// 최대 연장거리
// =====================================================

const float MAX_EXTENSION_MM = 70.0f;


// =====================================================
// 연장 완료 후 5초 정지
// =====================================================

const unsigned long HOLD_TIME_MS = 5000;


// =====================================================
// 초음파 측정 설정
// =====================================================

const unsigned long ECHO_TIMEOUT_US = 30000;


// 전체 센서 검사 주기
const unsigned long SENSOR_SCAN_INTERVAL_MS = 120;


// BASELINE 저장 후 추가 안전 대기
const unsigned long ARM_DELAY_AFTER_BASELINE_MS = 1000;


// ★ 초음파센서 간섭 방지
//
// 센서1 측정
// -> 65ms
// -> 센서3
// -> 65ms
// -> 센서4
//
// 방식
const unsigned long INTER_SENSOR_GAP_MS = 65;


// =====================================================
// 모터 속도
// =====================================================

const unsigned long STEP_INTERVAL_US = 1400;

const unsigned int STEP_HIGH_US = 5;


// =====================================================
// 다리 상태
// =====================================================

enum LegState
{
  IDLE,          // 대기
  EXTENDING,     // 연장
  HOLDING,       // 5초 정지
  RETRACTING,    // 수축
  WAIT_CLEAR     // 수축 후 센서 기준거리 복귀 대기
};


// =====================================================
// 다리 구조체
// =====================================================

struct Leg
{
  int number;

  int dirPin;
  int stepPin;

  int trigPin;
  int echoPin;

  int extendDir;

  // 다리별 바닥 공극
  float gapMm;

  // 초음파 초기 10회 평균
  float baselineMm;

  // 목표 연장거리
  float targetMm;

  // 목표 STEP
  long targetPulses;

  // 실제 현재 STEP 위치
  long currentPulses;

  // 상태
  LegState state;

  // 다음 STEP 출력시간
  unsigned long nextStepUs;

  // 5초 HOLD 시작시간
  unsigned long holdStartMs;

  // 수축 후 센서 복귀 확인
  int clearConfirmCount;
};


