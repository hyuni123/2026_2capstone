// =====================================================
// ★★★ 전체 센서 검사 ★★★
//
// 중요:
//
// 모터를 절대 먼저 출발시키지 않음.
//
// 센서1
// 센서3
// 센서4
//
// 모두 측정
//
// ↓
//
// 3라운드까지 반복
//
// ↓
//
// 각 다리 독립 판단
//
// ↓
//
// 조건을 만족한 모든 다리를
// 같은 순간에 EXTENDING 상태로 변경
// =====================================================

void scanAllLegs()
{
  float nowMm[LEG_COUNT] =
  {
    -1.0f,
    -1.0f,
    -1.0f
  };


  float increase[LEG_COUNT] =
  {
    0.0f,
    0.0f,
    0.0f
  };


  // =================================================
  // STEP 1
  //
  // ★ 센서 전부 먼저 읽음
  //
  // 각 센서 사이 65ms 쉬어서
  // 초음파 간섭 감소
  // =====================================================

  for (int i = 0; i < LEG_COUNT; i++)
  {
    if (
      legs[i].state == IDLE ||
      legs[i].state == WAIT_CLEAR
    )
    {
      nowMm[i] =
        readMedian3Mm(
          legs[i]
        );


      delay(
        INTER_SENSOR_GAP_MS
      );
    }
  }


  // =================================================
  // 수축 완료된 다리 재활성화
  // =====================================================

  for (int i = 0; i < LEG_COUNT; i++)
  {
    Leg &leg =
      legs[i];


    if (
      leg.state !=
      WAIT_CLEAR
    )
    {
      continue;
    }


    if (
      nowMm[i] <
      0
    )
    {
      continue;
    }


    float difference =
      fabs(
        nowMm[i] -
        leg.baselineMm
      );


    if (
      difference <=
      CLEAR_MARGIN_MM
    )
    {
      leg.clearConfirmCount++;


      if (
        leg.clearConfirmCount >=
        CLEAR_CONFIRM_ROUNDS
      )
      {
        leg.state =
          IDLE;


        leg.clearConfirmCount =
          0;


        Serial.print(
          "LEG "
        );

        Serial.print(
          leg.number
        );

        Serial.println(
          " RE-ARMED"
        );
      }
    }

    else
    {
      leg.clearConfirmCount =
        0;
    }
  }


  // =================================================
  // IDLE 다리들의 증가거리
  // =====================================================

  bool anyFar =
    false;


  for (int i = 0; i < LEG_COUNT; i++)
  {
    Leg &leg =
      legs[i];


    if (
      leg.state !=
      IDLE
    )
    {
      continue;
    }


    if (
      nowMm[i] <
      0
    )
    {
      continue;
    }


    increase[i] =
      nowMm[i] -
      leg.baselineMm;


    Serial.print(
      "LEG "
    );

    Serial.print(
      leg.number
    );


    Serial.print(
      " BASE="
    );

    Serial.print(
      leg.baselineMm,
      1
    );


    Serial.print(
      " NOW="
    );

    Serial.print(
      nowMm[i],
      1
    );


    Serial.print(
      " INC="
    );

    Serial.println(
      increase[i],
      1
    );


    if (
      increase[i] >=
      SENSOR_TRIGGER_MM
    )
    {
      anyFar =
        true;
    }
  }


  // =================================================
  // 아무 센서도 멀어지지 않음
  //
  // ★ 모터 아무것도 하지 않음
  // =====================================================

  if (
    !detectionWindowActive
  )
  {
    if (
      !anyFar
    )
    {
      return;
    }


    // 하나라도 실제 변화가 생겼으면
    // 3라운드 동시판정 시작

    detectionWindowActive =
      true;


    detectionRound =
      0;


    for (int i = 0; i < LEG_COUNT; i++)
    {
      detectionHits[i] =
        0;


      detectionIncreaseSum[i] =
        0.0f;
    }
  }


  // =================================================
  // 이번 라운드 기록
  // =====================================================

  detectionRound++;


  for (int i = 0; i < LEG_COUNT; i++)
  {
    Leg &leg =
      legs[i];


    if (
      leg.state !=
      IDLE
    )
    {
      continue;
    }


    if (
      nowMm[i] <
      0
    )
    {
      continue;
    }


    if (
      increase[i] >=
      SENSOR_TRIGGER_MM
    )
    {
      detectionHits[i]++;


      detectionIncreaseSum[i] +=
        increase[i];
    }
  }


  Serial.print(
    "DETECT ROUND "
  );

  Serial.print(
    detectionRound
  );

  Serial.print(
    "/"
  );

  Serial.println(
    DETECTION_ROUNDS
  );


  // 아직 3라운드 안 끝남
  if (
    detectionRound <
    DETECTION_ROUNDS
  )
  {
    return;
  }


  // =================================================
  // ★ 3라운드 완료
  //
  // 여기서 처음으로
  // 어떤 모터를 움직일지 결정
  // =====================================================

  bool startRequest[LEG_COUNT] =
  {
    false,
    false,
    false
  };


  float targetMm[LEG_COUNT] =
  {
    0.0f,
    0.0f,
    0.0f
  };


  int startCount =
    0;


  for (int i = 0; i < LEG_COUNT; i++)
  {
    Leg &leg =
      legs[i];


    if (
      leg.state !=
      IDLE
    )
    {
      continue;
    }


    // =================================================
    // 3번 중 최소 2번은
    // 실제로 멀어진 값이어야 함
    //
    // 아니면 그 다리는 가만히 둠
    // =====================================================

    if (
      detectionHits[i] <
      MIN_DETECTION_HITS
    )
    {
      Serial.print(
        "LEG "
      );

      Serial.print(
        leg.number
      );

      Serial.println(
        " NOT DETECTED -> STAY"
      );


      continue;
    }


    // =================================================
    // 해당 다리의 평균 증가량
    // =====================================================

    float averageIncrease =
      detectionIncreaseSum[i] /
      (float)detectionHits[i];


    // =================================================
    // 목표거리
    //
    // 1번 = 증가량 + 20mm
    // 3번 = 증가량 + 37mm
    // 4번 = 증가량 + 21mm
    // =====================================================

    float target =
      averageIncrease +
      leg.gapMm;


    if (
      target >
      MAX_EXTENSION_MM
    )
    {
      target =
        MAX_EXTENSION_MM;
    }


    startRequest[i] =
      true;


    targetMm[i] =
      target;


    startCount++;


    Serial.print(
      "LEG "
    );

    Serial.print(
      leg.number
    );


    Serial.print(
      " DETECTED | AVG="
    );

    Serial.print(
      averageIncrease,
      1
    );


    Serial.print(
      " + GAP="
    );

    Serial.print(
      leg.gapMm,
      1
    );


    Serial.print(
      " -> TARGET="
    );

    Serial.print(
      target,
      1
    );

    Serial.println(
      "mm"
    );
  }


  // 감지창 초기화
  resetDetectionWindow();


  if (
    startCount ==
    0
  )
  {
    return;
  }


  // =================================================
  // ★★★★★ 중요 ★★★★★
  //
  // 모든 센서의 판단을 전부 끝낸 다음
  // 여기서 한꺼번에 START.
  //
  // LEG3 O
  // LEG4 O
  //
  // -> 둘 다 여기서 동시에 EXTENDING
  // =====================================================

  Serial.println();

  Serial.print(
    ">>> SIMULTANEOUS START COUNT = "
  );

  Serial.println(
    startCount
  );


  for (int i = 0; i < LEG_COUNT; i++)
  {
    if (
      startRequest[i]
    )
    {
      startExtension(
        legs[i],
        targetMm[i]
      );
    }
  }
}


// =====================================================
// 초기 기준거리 저장
// =====================================================

void saveInitialBaselines()
{
  Serial.println();

  Serial.println(
    "===================================="
  );

  Serial.println(
    " BASELINE CALIBRATION"
  );

  Serial.println(
    " 10 READINGS AVERAGE"
  );

  Serial.println(
    "===================================="
  );


  for (int i = 0; i < LEG_COUNT; i++)
  {
    Leg &leg =
      legs[i];


    leg.currentPulses =
      0;


    leg.targetPulses =
      0;


    leg.targetMm =
      0.0f;


    leg.state =
      IDLE;


    leg.clearConfirmCount =
      0;


    // ★ 10번 평균
    leg.baselineMm =
      measureInitialAverage10(
        leg
      );


    // 센서 간 초음파 잔향 제거
    delay(100);
  }


  resetDetectionWindow();


  // BASELINE 저장 직후에도
  // 1초 동안 감지 시작 안 함

  armReadyMs =
    millis() +
    ARM_DELAY_AFTER_BASELINE_MS;


  Serial.println();

  Serial.println(
    "===================================="
  );

  Serial.println(
    " BASELINE SAVED"
  );

  Serial.println(
    " ALL MOTORS = 0mm"
  );

  Serial.println(
    " NO MOTOR MOVEMENT"
  );

  Serial.println(
    " WAIT FOR REAL DISTANCE INCREASE"
  );

  Serial.println(
    "===================================="
  );
}


// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(
    115200
  );


  delay(1000);


  for (int i = 0; i < LEG_COUNT; i++)
  {
    pinMode(
      legs[i].dirPin,
      OUTPUT
    );


    pinMode(
      legs[i].stepPin,
      OUTPUT
    );


    pinMode(
      legs[i].trigPin,
      OUTPUT
    );


    pinMode(
      legs[i].echoPin,
      INPUT
    );


    digitalWrite(
      legs[i].stepPin,
      LOW
    );


    digitalWrite(
      legs[i].trigPin,
      LOW
    );
  }


  Serial.println();

  Serial.println(
    "===================================="
  );

  Serial.println(
    " SMART LADDER FINAL"
  );

  Serial.println(
    " LEG 1 / 3 / 4"
  );

  Serial.println(
    "===================================="
  );


  Serial.println(
    "WAIT 3 SEC"
  );


  Serial.println(
    "MOTORS DO NOTHING"
  );


  // =================================================
  // ★ 처음 3초 진짜 아무것도 안 함
  // =====================================================

  delay(3000);


  // =================================================
  // 3초 뒤에 10번 평균 기준거리 저장
  // =====================================================

  saveInitialBaselines();


  lastSensorScanMs =
    millis();
}


// =====================================================
// LOOP
// =====================================================

void loop()
{
  // =================================================
  // 모터 3개를 계속 번갈아 처리
  //
  // 1 -> 3 -> 4 -> 1 -> 3 -> 4
  //
  // 따라서 둘 이상 동시에 회전 가능
  // =====================================================

  serviceLeg(
    legs[0]
  );


  serviceLeg(
    legs[1]
  );


  serviceLeg(
    legs[2]
  );


  // =================================================
  // 연장 / HOLD / 수축 중에는
  // 새 동작 판정을 하지 않음
  // =====================================================

  if (
    anyBusy()
  )
  {
    return;
  }


  // BASELINE 저장 직후 안전대기
  if (
    (long)(
      millis() -
      armReadyMs
    ) < 0
  )
  {
    return;
  }


  // =================================================
  // 센서 검사
  // =====================================================

  if (
    millis() -
    lastSensorScanMs
    >=
    SENSOR_SCAN_INTERVAL_MS
  )
  {
    lastSensorScanMs =
      millis();


    scanAllLegs();
  }
}
